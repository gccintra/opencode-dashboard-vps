{
  "name": "@opencode/pty-worker",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Isolated Node.js worker for node-pty PTYs (Bun-compatible via subprocess isolation).",
  "main": "src/index.ts",
  "scripts": {
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@types/node": "^18.19.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.3",
    "vitest": "3.2.6"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
