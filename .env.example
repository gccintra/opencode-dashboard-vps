# Server
SERVER_PORT=3001
WEB_PORT=5173

# Dev: path relativo ao CWD (criado automaticamente)
# Produção: usar path fora do repositório para evitar que git pull / bun test encostem no banco
DATABASE_PATH=./data/opencode.db
HARNESSES_PATH=/root/.config/opencode/harnesses

# Auth (required — server won't start without these)
AUTH_PASSWORD=changeme
JWT_SECRET=change-this-to-a-random-secret-at-least-32-chars
JWT_EXPIRY=7d

# PTY backend — how the server drives terminal sessions.
#   node-pty (default) : Node 18 worker + node-pty + pty-sighup-exec
#   control            : tmux control mode (tmux -C), no PTY/worker — avoids the
#                        node-pty CPU-spin wedge. See docs/poc-control-mode-findings.md
# Both use the same tmux daemon; flip with no data loss. Unset = node-pty.
PTY_BACKEND=node-pty

# tmux socket isolation (optional but recommended for multi-env setups).
# Each environment (prod / dev / worktree) should use a distinct socket so
# boot reconcile cannot reap sessions from other envs. Leave unset to use
# the system default socket (fine for single-env / production).
# init-env.sh generates this automatically for new worktrees.
# TMUX_SOCKET_PATH=/tmp/tmux-alf-dev.sock
